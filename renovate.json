{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>bifravst/renovate-config"],
  "packageRules": [
    {
      "matchPackagePatterns": ["aws-amplify", "@aws-amplify/core"],
      "groupName": "aws-amplify"
    },
    {
      "matchPackagePatterns": [
        "@nordicsemiconductor/asset-tracker-cloud-docs",
        "@sinclair/typebox"
      ],
      "groupName": "typebox"
    }
  ]
}
